# SEO: canonical origin (defaults to the primary Vercel domain below).
NEXT_PUBLIC_SITE_URL=https://www.mads.org.mt
# Optional URL-prefix Search Console verification token; DNS verification needs no code token.
GOOGLE_SITE_VERIFICATION=

# Public calendar settings (only public identifiers / URLs belong here)
NEXT_PUBLIC_MADS_CALENDAR_ID=
NEXT_PUBLIC_MADS_CALENDAR_SUBSCRIPTION_URL=
NEXT_PUBLIC_MADS_CALENDAR_ICS_URL=

# Server-only integration settings. Never prefix these with NEXT_PUBLIC_.
BREVO_API_KEY=
BREVO_LIST_ID=
# Double opt-in email template ID and HTTPS page to show after confirmation.
BREVO_DOI_TEMPLATE_ID=
BREVO_DOI_REDIRECT_URL=https://www.mads.org.mt/newsletter/confirmed
# Verified Brevo sender and MADS inbox for direct Contact form delivery.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Optional alternative to Brevo. If set, this HTTPS webhook takes precedence.
CONTACT_FORM_WEBHOOK_URL=
CONTACT_FORM_API_KEY=
# Optional local preview only: reuse the existing MADS service without local Brevo credentials.
# Ignored on Vercel and on requests outside localhost.
CONTACT_PREVIEW_SERVICE_URL=

# Public MADS-owned photo-folder URL, when one is approved.
NEXT_PUBLIC_MADS_PHOTO_DRIVE_URL=
